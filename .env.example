# Copy to .env and fill in real values. Never commit .env.

# Required. Base64-encoded HMAC key of at least 256 bits.
# Generate one with: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=

# Optional. Token lifetime in milliseconds (default 24 hours).
JWT_EXPIRATION=86400000

# Required for the production profile (PostgreSQL).
# docker compose ignores DATABASE_URL and points the app at its own db container.
DATABASE_URL=jdbc:postgresql://localhost:5432/workout_tracker
DATABASE_USERNAME=workout_tracker
DATABASE_PASSWORD=

# Optional. Creates an admin account on startup if the username does not exist yet.
# The password must be at least 12 characters.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
